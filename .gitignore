# Dependencies — 166MB, restored with `npm ci`
node_modules/

# Build output — regenerated by `npm run build`
dist/
dist-ssr/

# Generated assets. The sitemap is produced from src/i18n/routes.js on every
# build and the icons from public/web-app-manifest-512x512.png, so committing
# them would only create merge noise.
public/sitemap.xml
public/favicon-16x16.png
public/favicon-32x32.png
public/android-icon-192x192.png
public/apple-icon-*.png
public/ms-icon-144x144.png

# Local environment — never commit real values
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Local agent scratch
.claude/settings.local.json
